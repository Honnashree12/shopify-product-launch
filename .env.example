# Google Gemini / Vertex AI configuration for Google ADK
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Shopify Admin API configuration (real store)
SHOPIFY_STORE_URL=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_your_access_token_here
SHOPIFY_API_VERSION=2025-07
SHOPIFY_API_SECRET=your_shopify_app_client_secret_here  # For webhook verification

# FastAPI configuration
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=info

# Google Cloud configuration (if using Vertex AI backend)
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Email Service Configuration (HTML confirmation & sales team routing)
SALES_TEAM_EMAIL=sales-team@yourdomain.com
SENDER_EMAIL=space-workshops@yourdomain.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username@gmail.com
SMTP_PASSWORD=your-smtp-app-password
