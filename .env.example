# Google Gemini / Vertex AI configuration for Google ADK
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Shopify Admin API configuration (real store)
SHOPIFY_STORE_URL=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=your_shopify_admin_access_token_here
SHOPIFY_API_VERSION=2025-07

# FastAPI configuration
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=info

# Google Cloud configuration (if using Vertex AI backend)
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
